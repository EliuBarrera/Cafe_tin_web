# Copia este archivo a .env y completa los valores. .env nunca se sube al repositorio.
# En Render (API) y Vercel (panel) estas variables se cargan en su panel de configuración.

# --- Base de datos: Neon (PostgreSQL 16) ---
# Usa TU rama de desarrollo (dev-lizca, dev-eliu, dev-maria) y la conexión DIRECTA,
# no la "pooled" (la que tiene "-pooler" en el host): Flyway y Hibernate la necesitan.
# Neon → tu proyecto → Branches → tu rama → Connect → desmarcar "Connection pooling".
DB_URL=jdbc:postgresql://ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&stringtype=unspecified
DB_USER=neondb_owner
DB_PASSWORD=cambia-esto

# --- API ---
# Generar con: openssl rand -base64 64
JWT_SECRET=cambia-esto
# Orígenes permitidos por CORS (el panel en local y en Vercel), separados por coma.
CORS_ORIGINS=http://localhost:5173,https://cafetin-panel.vercel.app
# FIREBASE_CREDENTIALS=ruta/al/service-account.json   (Fase 5)

# --- Panel web (panel-web/.env.local) ---
# VITE_API_URL=http://localhost:8080
