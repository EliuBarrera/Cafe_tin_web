# Copia este archivo a .env y completa los valores. .env nunca se sube al repositorio.
# En Render (API) y Vercel (panel) estas variables se cargan en su panel de configuración.

# --- Base de datos: Neon (PostgreSQL 16) ---
# Usa TU rama de desarrollo (dev-lizca, dev-eliu, dev-maria) y la conexión DIRECTA,
# no la "pooled" (la que tiene "-pooler" en el host): Flyway y Hibernate la necesitan.
# Neon → tu proyecto → Branches → tu rama → Connect → desmarcar "Connection pooling".
DB_URL=jdbc:postgresql://ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&stringtype=unspecified
DB_USER=neondb_owner
DB_PASSWORD=cambia-esto

# --- API ---
# Mínimo 32 bytes o la API no arranca. Generar con (una sola línea): openssl rand -base64 48
JWT_SECRET=cambia-esto
# Orígenes permitidos por CORS (el panel en local y en Vercel), separados por coma.
CORS_ORIGINS=http://localhost:5173,https://cafe-tin-web.vercel.app
# FIREBASE_CREDENTIALS=ruta/al/service-account.json   (Fase 5)

# --- Correo de recuperación de contraseña (RF-03) ---
# Sin SPRING_MAIL_HOST el enlace solo se escribe en el log (perfil dev). En Render, con Gmail:
# crea una "contraseña de aplicación" (Cuenta de Google → Seguridad → Verificación en dos pasos
# → Contraseñas de aplicaciones) y úsala como SPRING_MAIL_PASSWORD, nunca la contraseña normal.
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=cuenta@gmail.com
# SPRING_MAIL_PASSWORD=cambia-esto
# MAIL_FROM=                     # opcional; vacío = SPRING_MAIL_USERNAME

# --- Cobro (RF-06): pasarela simulada o Mercado Pago. Guía completa: docs/mercadopago.md ---
# Sin estas variables la API usa la pasarela simulada (cobra al instante, sin dinero real).
# CAFETIN_PAGOS_PASARELA=mercadopago
# CAFETIN_PAGOS_COMISION=0              # 0.05 = la plataforma se queda el 5 % de cada pago
# CAFETIN_PAGOS_MONEDA=COP              # PEN en Perú; COP con la aplicación de prueba colombiana
# MP_CLIENT_ID=cambia-esto              # App ID de la aplicación en el panel de Mercado Pago
# MP_CLIENT_SECRET=cambia-esto          # Client Secret de esa aplicación
# MP_WEBHOOK_SECRET=cambia-esto         # Webhooks → Clave secreta
# CAFETIN_CIFRADO_LLAVE=cambia-esto     # cifra los tokens de cada cafetín: openssl rand -base64 32
# CAFETIN_URL_PUBLICA_API=https://cafetin-api-7vnp.onrender.com   # o la URL de tu túnel
# CAFETIN_URL_PANEL=http://localhost:5173

# --- Panel web (panel-web/.env.local) ---
# VITE_API_URL=http://localhost:8080
